FROM python:3.11-slim

WORKDIR /app

# Install system dependencies; upgrade distro packages so base-image CVEs
# (e.g. libssl3t64) are patched from the Debian repo at build time
RUN apt-get update && apt-get upgrade -y && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Debian ships its own copies of some Python packages (msgpack, setuptools)
# under /usr/lib/python3/dist-packages; the app uses the pip-installed
# versions from /usr/local/lib (earlier on sys.path). Drop the distro
# duplicates so image vulnerability scanners only see patched versions.
RUN apt-get purge -y python3-msgpack python3-setuptools || true \
    && rm -rf /usr/lib/python3/dist-packages/msgpack* \
              /usr/lib/python3/dist-packages/setuptools* \
              /usr/lib/python3/dist-packages/pkg_resources*

# Patch build tooling (pip/setuptools/wheel) to clear known CVEs shipped in the base image
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

# Copy requirements and install Python dependencies
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Re-assert patched build tooling in case a dependency pulled older setuptools/wheel
RUN pip install --no-cache-dir --upgrade "pip" "setuptools>=78.1.1" "wheel" \
    && pip install --no-cache-dir --upgrade "msgpack>=1.2.1"

# Copy application code
COPY backend/app ./app

# Copy alembic configuration and migrations
COPY backend/alembic.ini ./alembic.ini
COPY backend/alembic ./alembic

# Create a non-root user
RUN useradd --create-home --shell /bin/bash app_user
RUN chown -R app_user:app_user /app
USER app_user

# Expose port
EXPOSE 8000

# Command to run the application
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]