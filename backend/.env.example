# PO Helper Environment Configuration Example
# Copy this file to .env and fill in your actual values

# ====================
# Environment
ENVIRONMENT=development

# Security Settings
# ====================
# Generate with: python scripts/generate_secret_key.py --write
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Database Pooling
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Encryption for stored credentials
ENCRYPTION_SECRET=generate-another-secret-key-here

# ====================
# Database Configuration
# ====================
# For PostgreSQL (production):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/po_helper

# For SQLite (development):
# DATABASE_URL=sqlite+aiosqlite:///./po_helper.db

# ====================
# Redis Configuration (for Celery)
# ====================
REDIS_URL=redis://localhost:6379/0

# ====================
# Jira Integration
# ====================
# For Jira Cloud (*.atlassian.net)
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your-jira-api-token

# For Jira Server/Data Center
# JIRA_BASE_URL=https://jira.your-company.com
# JIRA_API_TOKEN=your-personal-access-token
# JIRA_FORCE_PAT=true  # Force PAT authentication for Server/DC

# Circuit breaker settings
JIRA_CB_ENABLED=true
JIRA_CB_FAILURE_THRESHOLD=5
JIRA_CB_RECOVERY_TIMEOUT=60
JIRA_CB_EXPECTED_EXCEPTION=JiraAPIError

# Request settings
JIRA_HTTP_TIMEOUT=30
JIRA_RETRY_TOTAL=3
JIRA_RETRY_BACKOFF_FACTOR=0.3

# ====================
# Confluence Integration
# ====================
CONFLUENCE_BASE_URL=https://your-wiki.atlassian.net
CONFLUENCE_EMAIL=your-email@example.com
CONFLUENCE_API_TOKEN=your-confluence-api-token

# ====================
# GitHub Integration (optional)
# ====================
# GITHUB_API_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx
# GITHUB_WEBHOOK_SECRET=your-webhook-secret
# GITHUB_ORG_NAME=your-org-name

# ====================
# GitLab Integration (optional)
# ====================
# GITLAB_BASE_URL=https://gitlab.com
# GITLAB_API_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx
# GITLAB_WEBHOOK_SECRET=your-webhook-secret

# ====================
# TestRail Integration (optional)
# ====================
# TESTRAIL_BASE_URL=https://your-company.testrail.com
# TESTRAIL_EMAIL=your-email@example.com
# TESTRAIL_API_TOKEN=your-testrail-api-token

# ====================
# CORS Configuration
# ====================
# Comma-separated list of allowed origins
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:5173"]

# ====================
# Application Settings
# ====================
PROJECT_NAME=PO Helper
VERSION=1.0.0
API_V1_STR=/api/v1

# Development settings
DEBUG=false
SKIP_SERVICE_AUTOCONNECT=false

# ====================
# Feature Flags
# ====================
ENABLE_CONFLUENCE_AUTOLINK=true
ENABLE_MATRIX_CACHE=true
ENABLE_GIT_INTEGRATION=false
ENABLE_TESTRAIL_INTEGRATION=false
ENABLE_QUALITY_GATES=true

# ====================
# Rate Limiting
# ====================
# Format: "requests/timeperiod" (e.g., "100/minute", "1000/hour")
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute
RATE_LIMIT_SYNC=10/hour

# ====================
# Celery Configuration
# ====================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=false  # Set to true for synchronous execution in development
CELERY_USE_IN_DEV=false  # Enable Celery dispatch even when ENVIRONMENT=development

# ====================
# Logging
# ====================
LOG_LEVEL=INFO
LOG_FORMAT=json  # Options: json, plain
LOG_FILE=/var/log/po_helper/app.log  # Optional: log to file

# ====================
# Monitoring (optional)
# ====================
# SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
https://xxxxx@sentry.io/xxxxx
# PROMETHEUS_ENABLED=false
# PROMETHEUS_PORT=9090

# ====================
# Multi-tenancy (future)
# ====================
# ENABLE_MULTI_TENANCY=false
# DEFAULT_TENANT_ID=default

# ====================
# WebSocket Configuration (future)
# ====================
# WS_ENABLED=false
# WS_HEARTBEAT_INTERVAL=30
# WS_MAX_CONNECTIONS=100
